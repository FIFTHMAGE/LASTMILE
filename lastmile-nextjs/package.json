{
  "name": "lastmile-nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "build:production": "NODE_ENV=production next build",
    "deploy": "npm run pre-deploy && vercel --prod",
    "deploy:preview": "vercel",
    "pre-deploy": "node scripts/pre-deploy.js",
    "post-deploy": "node scripts/deployment-check.js",
    "health-check": "node scripts/deployment-check.js",
    "postbuild": "echo 'Build completed successfully!'",
    "setup": "node scripts/setup-env.js",
    "setup:env": "node scripts/setup-env.js",
    "setup:db": "node scripts/init-database.js",
    "setup:all": "npm run setup:env && npm install && npm run setup:db",
    "db:init": "node scripts/init-database.js",
    "db:reset": "node scripts/init-database.js --reset"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "mongodb": "^6.3.0",
    "mongoose": "^8.16.4",
    "next": "15.4.4",
    "nodemailer": "^7.0.5",
    "paystack": "^2.0.1",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.61.1",
    "react-hot-toast": "^2.5.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "typescript": "^5.7.2"
  }
}
